{
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "CONFIG": "readonly",
    "TIME_MS": "readonly",
    "AI_ERROR": "readonly",
    "DEMO": "readonly",
    "GeminiClient": "readonly",
    "UIHelpers": "readonly",
    "EventData": "readonly",
    "Planner": "readonly",
    "BudgetMgr": "readonly"
  },
  "rules": {
    "strict": [
      "error",
      "global"
    ],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "info"
        ]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "vars": "local",
        "args": "after-used"
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "curly": "error",
    "no-throw-literal": "error",
    "prefer-template": "error",
    "no-param-reassign": [
      "error",
      {
        "props": false
      }
    ],
    "consistent-return": "error"
  }
}